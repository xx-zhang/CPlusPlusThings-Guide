     ~rectangle() {
         cout << "~rectangle" << endl;
     }
+
+    void print() const override { cout << "rectangle::print" << endl; }
 };
+
+// 工厂：返回基类指针
+// （下面 switch 用的是 scoped enum 标签 `case shape_type::circle:`，合法；
+//   某些静态检查器会误判为"非 case 标签"，那是误报）（示例里用 auto_ptr<shape>/unique_ptr<shape> 接管）
+inline shape *create_shape(shape_type t) {
+    switch (t) {
+        case shape_type::circle:    { return new circle; }
+        case shape_type::triangle:  { return new triangle; }
+        case shape_type::rectangle: { return new rectangle; }
+    }
+    return nullptr;
+}
